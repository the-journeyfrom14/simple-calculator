# simple-calculator

operator = input("What operator do you want: (+ - * /): ")

num1 = float(input("Enter number: "))
num2 = float(input("Enter number: "))

if operator == "+":
	total = num1 + num2
	print(f"{num1} + {num2} = {round(total,2)}")
	
elif operator == "-":
	total = num1 - num2
	print(f"{num1} - {num2} = {round(total,2)}")

elif operator == "*":
	total = num1 * num2
	print(f"{num1} * {num2} = {round(total,2)}")

elif operator =="/":
	if num1 == 0:
		print("0 divided by anything is 0")
	elif num2 == 0:
			print("cannot divide by 0")
	else:
				total = num1 / num2
				print(f"{num1} / {num2} = {round(total,2)}")
